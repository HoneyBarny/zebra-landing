---
import ArticleCard from './ArticleCard.astro';
import { articleUrl, dateLabel, estimateReadingTime } from '../../lib/content';
import type { ArticleEntry } from '../../lib/content';

interface Props {
  articles: ArticleEntry[];
  title?: string;
  eyebrow?: string;
  minReadLabel?: string;
  localePath?: string;
}

const { articles, title = 'Related reading', eyebrow = 'Keep exploring', minReadLabel = 'min read', localePath = '/' } = Astro.props;
const urlFor = (slug: string) => (localePath === '/' ? articleUrl(slug) : `${localePath}blog/${slug}/`);
// Localized entries carry their English slug in originalSlug; their id includes the locale folder.
const articleSlug = (article: ArticleEntry) => (article.data as { originalSlug?: string }).originalSlug ?? article.id;
---

{articles.length > 0 && (
  <section class="related-articles section section-band section-band--soft">
    <div class="section-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="article-grid">
      {articles.map((article) => (
        <ArticleCard
          title={article.data.title}
          href={urlFor(articleSlug(article))}
          excerpt={article.data.excerpt}
          category={article.data.category}
          categories={article.data.categories}
          publishedAt={dateLabel(article.data.publishedAt)}
          readingTime={estimateReadingTime(article.body)}
          minReadLabel={minReadLabel}
          image={article.data.heroImage}
          imageAlt={article.data.heroImageAlt}
        />
      ))}
    </div>
  </section>
)}
