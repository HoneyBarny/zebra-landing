---
import SectionIntro from './SectionIntro.astro';

interface Props {
  eyebrow: string;
  title: string;
  statement: string;
  support: string;
  flowLabel: string;
  flow?: string[];
  bullets: string[];
  painPoints: string[];
}

const { eyebrow, title, statement, support, flowLabel, flow = ['Notes', 'Screenshots', 'Memory', 'Zebra'], bullets, painPoints } = Astro.props;
---

<section class="section problem-section" aria-labelledby="problem-heading">
  <SectionIntro eyebrow={eyebrow} title={title} id="problem-heading" narrow={true} />
  <div class="problem-grid">
    <div class="problem-copy">
      <p class="mini-label">{flowLabel}</p>
      <div class="problem-flow" aria-label={flowLabel}>
        {flow.map((item) => <span>{item}</span>)}
      </div>
      <p class="problem-statement">{statement}</p>
      <p>{support}</p>
      <ul class="problem-list" aria-label="Core frustrations">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>
    <ul class="problem-moments">
      {painPoints.map((point) => <li>{point}</li>)}
    </ul>
  </div>
</section>
