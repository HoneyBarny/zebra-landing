---
import { appStoreUrlFor } from '../../lib/appStoreUrl';

interface Props {
  href: string;
  src: string;
  loading?: 'eager' | 'lazy';
  className?: string;
  trackingLocation?: string;
}

const { href, src, loading = 'lazy', className, trackingLocation } = Astro.props;

// Campaign attribution is applied here rather than at each call site, so all
// six badge usages get it from one place and none can drift. Falls through to
// the given href untouched when there is no tracking location, or when the
// href is not an App Store link.
const resolvedHref = appStoreUrlFor(trackingLocation, href);
---

<a
  class:list={['app-store-badge-link', className]}
  href={resolvedHref}
  target="_blank"
  rel="noopener noreferrer"
  data-app-store-cta={trackingLocation ? 'true' : undefined}
  data-cta-location={trackingLocation}
  data-cta-label="Download on the App Store"
>
  <img
    class="app-store-badge"
    src={src}
    alt="Download on the App Store"
    width="246"
    height="82"
    loading={loading}
    decoding="async"
  />
</a>
