---
interface LinkItem {
  href: string;
  label: string;
}

interface Brand {
  href: string;
  name: string;
  subtitle: string;
  logo: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}

interface Props {
  brand: Brand;
  links: LinkItem[];
  localeSwitcher?: {
    label: string;
    links: Array<LinkItem & { locale?: string; flag?: string }>;
  };
}

const { brand, links, localeSwitcher } = Astro.props;
---

<header class="site-header">
  <a class="brand-lockup" href={brand.href} aria-label={`${brand.name} home`}>
    <img
      class="brand-logo"
      src={brand.logo.src}
      alt={brand.logo.alt}
      width={brand.logo.width}
      height={brand.logo.height}
    />
    <div>
      <p class="eyebrow brand-name">{brand.name}</p>
      <p class="brand-subtitle">{brand.subtitle}</p>
    </div>
  </a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
    {localeSwitcher && (
      <nav class="locale-switcher" aria-label={localeSwitcher.label}>
        {localeSwitcher.links.map((link) => (
          <a href={link.href} lang={link.locale}>
            {link.flag && <span class="locale-flag" aria-hidden="true">{link.flag}</span>}
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
</header>
