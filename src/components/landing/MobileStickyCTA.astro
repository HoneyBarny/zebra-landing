---
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
  href: string;
  label: string;
  note: string;
  badgeUrl: string;
  badgeAlt?: string;
  ariaLabel?: string;
}

const { href, label, note, badgeUrl, badgeAlt, ariaLabel = 'Download Zebra on the App Store' } = Astro.props;
---

<aside class="mobile-sticky-cta" aria-label={ariaLabel}>
  <span>{note}</span>
  <AppStoreBadge href={href} src={badgeUrl} alt={badgeAlt} className="mobile-sticky-badge" trackingLocation="mobile_sticky" />
</aside>
