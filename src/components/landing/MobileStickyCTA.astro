---
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
  href: string;
  label: string;
  note: string;
  badgeUrl: string;
}

const { href, label, note, badgeUrl } = Astro.props;
---

<aside class="mobile-sticky-cta" aria-label="Download Zebra on the App Store">
  <span>{note}</span>
  <AppStoreBadge href={href} src={badgeUrl} className="mobile-sticky-badge" trackingLocation="mobile_sticky" />
</aside>
