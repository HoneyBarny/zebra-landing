---
import ConsentPreferencesButton from '../ConsentPreferencesButton.astro';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  body: string;
  trustLine: string;
  links: FooterLink[];
}

const { body, trustLine, links } = Astro.props;
---

<footer class="site-footer">
  <div>
    <p class="footer-copy">{body}</p>
    <p class="footer-trust">{trustLine}</p>
  </div>
  <nav class="footer-nav" aria-label="Footer">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    {/*
      A control, not a destination, so it is a button rather than a link — but
      it sits with the footer links because that is where people look for it.
    */}
    <ConsentPreferencesButton />
  </nav>
</footer>

