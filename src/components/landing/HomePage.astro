---
import FAQSection from './FAQSection.astro';
import FinalCTASection from './FinalCTASection.astro';
import GuidesSection from './GuidesSection.astro';
import HeroSection from './HeroSection.astro';
import HowItWorksSection from './HowItWorksSection.astro';
import AppointmentPrepSection from './AppointmentPrepSection.astro';
import ComparisonSection from './ComparisonSection.astro';
import MobileStickyCTA from './MobileStickyCTA.astro';
import ProblemSection from './ProblemSection.astro';
import ProofBridgeSection from './ProofBridgeSection.astro';
import ReportSection from './ReportSection.astro';
import SearchContentSection from './SearchContentSection.astro';
import ScreenshotCarouselSection from './ScreenshotCarouselSection.astro';
import ShowcaseSection from './ShowcaseSection.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import TrackingPathSection from './TrackingPathSection.astro';
import TrustSection from './TrustSection.astro';
import WhatZebraTracksSection from './WhatZebraTracksSection.astro';

interface Props {
  page: any;
}

const { page } = Astro.props;

// The English homepage opts into a shorter, research-ordered layout:
// problem → capture → understand change → prepare → treatment context →
// orthostatic test → alternatives → who it is for → trust → guides → FAQ.
// The localized homepages still spread the legacy `homePage` object and keep
// the original layout until they are re-translated.
const isFocused = page.layout === 'focused';
---

<div class="page-shell">
  <SiteHeader brand={page.header.brand} links={page.header.links} localeSwitcher={page.localeSwitcher} />

  {isFocused ? (
  <main>
    <HeroSection
      {...page.hero}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <ProblemSection {...page.problem} />
    <ShowcaseSection
      {...page.dailyTracking}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <ShowcaseSection
      {...page.trends}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <ReportSection
      {...page.doctorReport}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <WhatZebraTracksSection {...page.treatmentContext} />
    <ShowcaseSection {...page.orthostaticTest} />
    <ComparisonSection {...page.comparison} />
    <TrackingPathSection {...page.trackingPaths} />
    <TrustSection {...page.trust} />
    <GuidesSection {...page.guides} />
    <FAQSection {...page.faq} />
    <FinalCTASection
      {...page.finalCta}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
  </main>
  ) : (
  <main>
    <HeroSection
      {...page.hero}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <ProblemSection {...page.problem} />
    <WhatZebraTracksSection {...page.whatZebraTracks} />
    <TrackingPathSection {...page.trackingPaths} />
    <ComparisonSection {...page.comparison} />
    <ProofBridgeSection {...page.proofBridge} />
    <ReportSection
      {...page.doctorReport}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <AppointmentPrepSection {...page.appointmentPrep} />
    <HowItWorksSection {...page.howItWorks} />
    <ScreenshotCarouselSection {...page.screenshotCarousel} />
    <ShowcaseSection
      {...page.dailyTracking}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
    <ShowcaseSection {...page.orthostaticTest} />
    <SearchContentSection {...page.searchContent} />
    <TrustSection {...page.trust} />
    <GuidesSection {...page.guides} />
    <FAQSection {...page.faq} />
    <FinalCTASection
      {...page.finalCta}
      appStoreURL={page.appStore.url}
      appStoreBadgeURL={page.appStore.badgeUrl}
      appStoreBadgeAlt={page.appStore.badgeAlt}
    />
  </main>
  )}

  <SiteFooter {...page.footer} localeSwitcher={page.localeSwitcher} />
  <MobileStickyCTA
    {...page.mobileStickyCta}
    href={page.appStore.url}
    badgeUrl={page.appStore.badgeUrl}
    badgeAlt={page.appStore.badgeAlt}
  />
</div>
