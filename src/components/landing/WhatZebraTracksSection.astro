---
import SectionIntro from './SectionIntro.astro';

interface TrackItem {
  title: string;
  body: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: TrackItem[];
  note: string;
}

const { id = 'what-zebra-tracks', eyebrow, title, intro, items, note } = Astro.props;
const headingId = id === 'what-zebra-tracks' ? 'tracks-heading' : `${id}-heading`;
---

<section class="section tracks-section section-band" id={id} aria-labelledby={headingId}>
  <SectionIntro eyebrow={eyebrow} title={title} body={intro} id={headingId} narrow={true} />
  <div class="tracks-grid">
    {items.map((item) => (
      <article class="track-card">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>
  <p class="tracks-note">{note}</p>
</section>
