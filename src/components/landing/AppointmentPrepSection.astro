---
import SectionIntro from './SectionIntro.astro';

interface ChecklistItem {
  label: string;
  body: string;
}

interface PathItem {
  condition: string;
  body: string;
}

interface ReportRow {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  checklistTitle: string;
  checklist: ChecklistItem[];
  pathsTitle: string;
  paths: PathItem[];
  samplePreview: {
    eyebrow: string;
    title: string;
    meta: string;
    rows: ReportRow[];
    note: string;
  };
  note: string;
}

const {
  eyebrow,
  title,
  intro,
  checklistTitle,
  checklist,
  pathsTitle,
  paths,
  samplePreview,
  note,
} = Astro.props;
---

<section class="section appointment-prep-section section-band" id="appointment-prep" aria-labelledby="appointment-prep-heading">
  <SectionIntro eyebrow={eyebrow} title={title} body={intro} id="appointment-prep-heading" />
  <div class="appointment-prep-grid">
    <div class="appointment-prep-panel">
      <p class="mini-label">{checklistTitle}</p>
      <div class="appointment-prep-list">
        {checklist.map((item, index) => (
          <article class="appointment-prep-item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.label}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <aside class="appointment-prep-paths" aria-label={samplePreview.title}>
      <div class="sample-report-preview">
        <div class="sample-report-header">
          <p class="mini-label">{samplePreview.eyebrow}</p>
          <h3>{samplePreview.title}</h3>
          <p>{samplePreview.meta}</p>
        </div>
        <div class="sample-report-rows">
          {samplePreview.rows.map((row) => (
            <div class="sample-report-row">
              <span>{row.label}</span>
              <strong>{row.value}</strong>
            </div>
          ))}
        </div>
        <p class="sample-report-note">{samplePreview.note}</p>
      </div>

      <div>
        <p class="mini-label">{pathsTitle}</p>
        <div class="appointment-prep-path-list">
          {paths.map((path) => (
            <article>
              <h3>{path.condition}</h3>
              <p>{path.body}</p>
            </article>
          ))}
        </div>
      </div>
      <p class="appointment-prep-note">{note}</p>
    </aside>
  </div>
</section>
