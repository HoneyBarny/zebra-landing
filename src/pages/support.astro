---
import SupportPage from '../components/content/SupportPage.astro';
import { supportPage } from '../data/site-content';
import { alternatesForPath } from '../data/locales/shared';

const page = {
	...supportPage,
	seo: {
		...supportPage.seo,
		alternates: alternatesForPath('/support/'),
	},
};
---

<SupportPage page={page} />
