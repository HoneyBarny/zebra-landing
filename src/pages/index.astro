---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/landing/HomePage.astro';
import { homePageEn } from '../data/locales';

const homePage = homePageEn;
---

<BaseLayout
  lang={homePage.locale.htmlLang}
  title={homePage.seo.title}
  description={homePage.seo.description}
  ogImage={homePage.seo.ogImage}
  ogImageAlt={homePage.seo.ogImageAlt}
  schema={homePage.schema}
  alternates={homePage.seo.alternates}
  consentBanner={homePage.consentBanner}
>
  <HomePage page={homePage} />
</BaseLayout>
