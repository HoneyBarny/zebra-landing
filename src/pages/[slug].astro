---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/landing/AppStoreBadge.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import PhoneMedia from '../components/landing/PhoneMedia.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import { screenshots } from '../data/screenshots';
import { homePage } from '../data/site-content';
import { siteConfig, toAbsoluteUrl } from '../data/site-config';
import {
  getSearchPageUrl,
  getSoftwareApplicationSchema,
  searchPages,
  trustedReferences,
  type SearchPage,
} from '../data/search-pages';

export function getStaticPaths() {
  return searchPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: SearchPage };
const canonical = getSearchPageUrl(page);
const reviewIsoDate = page.lastReviewed === 'August 1, 2026' ? '2026-08-01' : '2026-07-25';
const reportPreview = screenshots.appointmentPreparation;
const sampleReportHref = '/sample-doctor-report.pdf';
const schema = [
  getSoftwareApplicationSchema(page),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: page.h1,
    url: canonical,
    description: page.description,
    dateModified: reviewIsoDate,
    about: ['POTS', 'EDS', 'Fibromyalgia', 'Symptom tracking', 'Doctor-ready report'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: toAbsoluteUrl('/'),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: page.h1,
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  ...(page.comparison
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: `${page.h1} comparison factors`,
          itemListElement: page.comparison.rows.map((row, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: row.factor,
            description: `${page.comparison?.columns[0]}: ${row.first} ${page.comparison?.columns[1]}: ${row.second}`,
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogImage={homePage.seo.ogImage}
  ogImageAlt={homePage.seo.ogImageAlt}
  schema={schema}
>
  <div class="page-shell">
    <SiteHeader brand={homePage.header.brand} links={homePage.header.links} />
    <main>
      <section class="section search-page-hero">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: page.eyebrow }]} />
        <div class="search-page-hero-grid">
          <div>
            <p class="eyebrow">{page.eyebrow}</p>
            <p class="reviewed-line">Last reviewed: {page.lastReviewed}</p>
            <h1>{page.h1}</h1>
            <p class="direct-answer">{page.directAnswer}</p>
            <div class="hero-cta-row">
              <AppStoreBadge
                href={siteConfig.appStore.url}
                src={siteConfig.appStore.badgeUrl}
                loading="eager"
                trackingLocation={`search_page_${page.slug}_hero`}
              />
              <p>{page.cta}. Built for iPhone. Not medical advice.</p>
            </div>
          </div>
          <aside class="search-page-proof">
            <p class="mini-label">Zebra in one sentence</p>
            <strong>Track flares, symptoms, meds, salt, water, and orthostatic vitals in under 60 seconds.</strong>
            <p>Then create a doctor-ready report from the history you entered.</p>
          </aside>
        </div>
      </section>

      <section class="section search-page-section">
        <div class="search-page-columns">
          <article>
            <p class="eyebrow">Plain answer</p>
            <h2>What this page is about</h2>
            {page.summary.map((paragraph) => <p>{paragraph}</p>)}
          </article>
          <article>
            <p class="eyebrow">Why it matters</p>
            <h2>{page.whyTitle}</h2>
            <ul class="check-list">
              {page.why.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>

      {page.comparison && (
        <section class="section section-band search-page-section" aria-labelledby="comparison-heading">
          <div class="section-intro section-intro--narrow">
            <p class="eyebrow">Comparison table</p>
            <h2 id="comparison-heading">How the options compare</h2>
            <p>Use this as a fit check, not a winner-takes-all verdict. The right tracker is the one you can keep using when symptoms are already taking up the day.</p>
          </div>
          <div class="comparison-table-wrap">
            <table class="comparison-table">
              <thead>
                <tr>
                  <th>Factor</th>
                  <th>{page.comparison.columns[0]}</th>
                  <th>{page.comparison.columns[1]}</th>
                </tr>
              </thead>
              <tbody>
                {page.comparison.rows.map((row) => (
                  <tr>
                    <th>{row.factor}</th>
                    <td>{row.first}</td>
                    <td>{row.second}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="section search-page-section" aria-labelledby="decision-heading">
        <div class="search-page-columns">
          <article>
            <p class="eyebrow">Best fit</p>
            <h2 id="decision-heading">Choose Zebra if...</h2>
            <ul class="check-list">
              {page.bestFor.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <p class="eyebrow">Not trying to be</p>
            <h2>Choose something else if...</h2>
            <ul class="check-list">
              {page.notFor.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="section section-band search-page-section" aria-labelledby="report-preview-heading">
        <div class="search-page-report-grid">
          <article>
            <p class="eyebrow">Report preview</p>
            <h2 id="report-preview-heading">See what the appointment payoff looks like.</h2>
            <p>
              Zebra turns patient-entered history into a doctor-ready PDF report with flares,
              symptoms, medications, salt, water, triggers, notes, and orthostatic vitals.
              Premium includes PDF report export.
            </p>
            <ul class="check-list">
              <li>30-day summary for appointment prep</li>
              <li>Orthostatic observations connected to daily symptom context</li>
              <li>Designed to reduce memory work, not replace medical care</li>
            </ul>
            <p class="sample-report-link">
              <a href={sampleReportHref} target="_blank" rel="noopener noreferrer">View sample doctor report PDF</a>
              <span>Uses fake patient data for preview only.</span>
            </p>
          </article>
          <div class="search-page-report-media">
            <PhoneMedia
              {...reportPreview}
              shell="report"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <section class="section search-page-section">
        <div class="search-page-columns">
          <article>
            <p class="eyebrow">What Zebra tracks</p>
            <h2>{page.tracksTitle}</h2>
            <ul class="check-list">
              {page.tracks.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="search-page-trust">
            <p class="eyebrow">Trust and safety</p>
            <h2>Medically careful by design.</h2>
            <p>{page.trust}</p>
            <p>
              Zebra does not diagnose, treat, prevent, cure, replace medical care, or interpret symptoms.
              Bring concerning symptoms, medication questions, salt/fluid changes, and treatment decisions
              to a qualified healthcare professional.
            </p>
          </article>
        </div>
      </section>

      <section class="section section-band search-page-section" aria-labelledby="faq-heading">
        <div class="section-intro section-intro--narrow">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-heading">Questions people ask before downloading Zebra.</h2>
        </div>
        <div class="faq-list">
          {page.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section search-page-section">
        <div class="search-page-columns">
          <article>
            <p class="eyebrow">Related pages</p>
            <h2>Keep exploring the same search cluster.</h2>
            <div class="related-link-grid">
              {page.related.map((link) => <a class="filter-chip" href={link.href}>{link.label}</a>)}
            </div>
          </article>
          <article>
            <p class="eyebrow">Trusted references</p>
            <h2>Source-backed condition framing.</h2>
            <ul class="reference-list">
              {trustedReferences.map((reference) => (
                <li><a href={reference.href} target="_blank" rel="noopener noreferrer">{reference.label}</a></li>
              ))}
            </ul>
          </article>
        </div>
      </section>

      <section class="section final-cta">
        <p class="eyebrow">Download Zebra</p>
        <h2>Start tracking today, before the next appointment asks for the whole story.</h2>
        <p>{page.cta}. Track free; Premium includes unlimited history, PDF report export, and the full orthostatic archive.</p>
        <AppStoreBadge
          href={siteConfig.appStore.url}
          src={siteConfig.appStore.badgeUrl}
          trackingLocation={`search_page_${page.slug}_final`}
        />
      </section>
    </main>
    <SiteFooter {...homePage.footer} />
  </div>
</BaseLayout>
