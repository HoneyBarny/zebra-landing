---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/landing/SiteHeader.astro';
import SiteFooter from '../../components/landing/SiteFooter.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import { authorProfiles } from '../../data/content-taxonomy';
import { homePage } from '../../data/site-content';
import { authorUrl, getBreadcrumbSchema, getPublishedArticles } from '../../lib/content';

const articles = getPublishedArticles(await getCollection('articles'));
const authors = Object.values(authorProfiles).map((author) => ({
  ...author,
  articleCount: articles.filter((article) => article.data.author === author.slug).length,
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'About Zebra content',
    description: 'How Zebra’s symptom-tracking, appointment-preparation, and knowledge-hub guides are written and sourced.',
  },
  getBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Authors', item: '/authors/' },
  ]),
];
---

<BaseLayout
  title="About Zebra content | How the Symptom Tracking Guides Are Written"
  description="How Zebra’s guides on symptom tracking, appointment preparation, and living with POTS, EDS, and Fibromyalgia are written and sourced."
  schema={schema}
>
  <div class="page-shell">
    <SiteHeader brand={homePage.header.brand} links={homePage.header.links} />
    <main>
      <section class="section category-hero">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Authors' }]} />
        <p class="eyebrow">About</p>
        <h1>How Zebra’s guides are written.</h1>
      </section>

      <section class="section">
        <div class="knowledge-grid">
          {authors.map((author) => (
            <article class="knowledge-card">
              <p class="mini-label">{author.articleCount} articles</p>
              <h2><a href={authorUrl(author.slug)}>{author.name}</a></h2>
              <p>{author.bio}</p>
            </article>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter {...homePage.footer} />
  </div>
</BaseLayout>
