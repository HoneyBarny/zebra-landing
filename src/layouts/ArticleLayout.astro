---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import RelatedArticles from '../components/content/RelatedArticles.astro';
import { articleSources, nationalSourcesByLang } from '../data/article-sources';
import { homePage } from '../data/site-content';
import { articleAlternatesFor, publishedLocalesByOriginal } from '../lib/article-alternates';
import {
  articleUrl,
  categoryUrlFromName,
  dateLabel,
  estimateReadingTime,
  localizedTopicUrlFromName,
} from '../lib/content';
import type { ArticleEntry } from '../lib/content';
import { localizedCategoryName } from '../data/locales/article-translations';


interface Props {
  article: ArticleEntry;
  headings: Array<{ depth: number; slug: string; text: string }>;
  relatedArticles: ArticleEntry[];
  canonical: string;
  schema: Array<Record<string, unknown>>;
  lang?: string;
  localePath?: string;
  articlePath?: string;
  alternatesPath?: string;
  brand?: typeof homePage.header.brand;
  headerLinks?: typeof homePage.header.links;
  footer?: typeof homePage.footer;
  localeSwitcher?: unknown;
  consentBanner?: unknown;
  labels?: {
    home: string;
    blog: string;
    updated: string;
    minRead: string;
    putIntoPractice: string;
    downloadZebra: string;
    knowledgeHub: string;
    tableOfContents: string;
    whyThisPageExists: string;
    editorialReview: string;
    reviewedBy: string;
    lastReviewed: string;
    directRoute: string;
    relatedReading: string;
    keepExploring: string;
  };
}

const {
  article,
  headings,
  relatedArticles,
  canonical,
  schema,
  lang = 'en',
  localePath = '/',
  articlePath = articleUrl(article.id),
  alternatesPath = articlePath,
  brand = homePage.header.brand,
  headerLinks = homePage.header.links,
  footer = homePage.footer,
  localeSwitcher,
  consentBanner,
  labels = {
    home: 'Home',
    blog: 'Blog',
    updated: 'Updated',
    minRead: 'min read',
    putIntoPractice: 'Put this into practice',
    downloadZebra: 'Download Zebra',
    knowledgeHub: 'Knowledge hub',
    tableOfContents: 'Table of contents',
    whyThisPageExists: 'Why this page exists',
    editorialReview: 'Editorial review',
    reviewedBy: 'Reviewed by',
    lastReviewed: 'Last updated',
    directRoute: 'Direct route',
    relatedReading: 'Related reading',
    keepExploring: 'Keep exploring',
    sources: 'Sources',
    sourcesNote: 'General information, not medical advice.',
    sourcesInGuide: 'Sources in this guide',
    generalSources: 'General sources behind Zebra’s research',
  },
} = Astro.props;

const alternates = articleAlternatesFor(
  alternatesPath.replace(/^\/blog\//, '').replace(/\/$/, ''),
  await publishedLocalesByOriginal(),
);
const tocHeadings = headings.filter((heading) => heading.depth <= 2);

// Links the guide itself cites, shown at the end so each guide names where its information came from.
// Our own pages and the App Store link are not sources; a few links were checked and found broken.
const brokenLinks = new Set(['https://www.ehlers-danlos.com/2014-physicians-conference/Pocinki.pdf']);
const guideSources = (() => {
  const seen = new Map<string, string>();
  for (const match of article.body.matchAll(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g)) {
    const [, label, url] = match;
    if (brokenLinks.has(url) || url.includes('apps.apple.com') || url.includes('zebratracker.app')) continue;
    if (!seen.has(url)) seen.set(url, label.replace(/\s+/g, ' ').trim());
  }
  return [...seen.entries()].map(([url, label]) => ({ url, label }));
})();
const dateLocale = lang === 'de-DE' ? 'de-DE' : lang === 'es-ES' ? 'es-ES' : lang === 'fr-FR' ? 'fr-FR' : 'en-US';
const seoTitle = article.data.seoTitle.length > 60
  ? article.data.seoTitle.replace(/\s+\|\s+Zebra$/, '')
  : article.data.seoTitle;
---

<BaseLayout
  title={seoTitle}
  description={article.data.metaDescription}
  noindex={article.data.noindex}
  ogImage={article.data.heroImage}
  ogImageAlt={article.data.heroImageAlt}
  ogType="article"
  publishedTime={article.data.publishedAt}
  modifiedTime={article.data.updatedAt}
  schema={schema}
  lang={lang}
  alternates={alternates}
  consentBanner={consentBanner}
>
  <div class="page-shell">
    <SiteHeader brand={brand} links={headerLinks} localeSwitcher={localeSwitcher} />
    <main>
      <section class="section article-hero">
        <Breadcrumbs
          items={[
            { label: labels.home, href: localePath },
            { label: labels.blog, href: `${localePath === '/' ? '/' : localePath}blog/` },
            { label: localizedCategoryName(article.data.category, localePath), href: localePath === '/' ? categoryUrlFromName(article.data.categories[0] ?? article.data.category) : `${localePath}blog/` },
            { label: article.data.title },
          ]}
        />

        <div class="article-hero-grid">
          <div class="article-hero-copy">
            <p class="eyebrow">{article.data.cluster}</p>
            <h1>{article.data.title}</h1>
            <p class="article-subtitle">{article.data.subtitle}</p>
            <div class="article-meta-row">
              <span>{dateLabel(article.data.publishedAt, dateLocale)}</span>
              <span>{labels.updated} {dateLabel(article.data.updatedAt ?? article.data.publishedAt, dateLocale)}</span>
              <span>{estimateReadingTime(article.body)} {labels.minRead}</span>
            </div>
            <div class="article-chip-row">
              {article.data.categories.map((category) => (
                <a class="article-chip" href={localePath === '/' ? categoryUrlFromName(category) : `${localePath}blog/`}>
                  {localizedCategoryName(category, localePath)}
                </a>
              ))}
            </div>
          </div>

          <figure class="article-hero-media">
            <img
              src={article.data.heroImage}
              alt={article.data.heroImageAlt}
              width="1530"
              height="3036"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="section article-shell">
        <div class="article-main">
          <slot />

          <section class="article-cta-card" aria-label="Download Zebra">
            <p class="eyebrow">{labels.putIntoPractice}</p>
            <h2>{article.data.ctaLabel}</h2>
            <p>{article.data.ctaNote}</p>
            <a class="inline-cta" href={article.data.ctaHref}>{labels.downloadZebra}</a>
          </section>

          <section class="entity-links" aria-label="Knowledge entities">
            <p class="mini-label">{labels.knowledgeHub}</p>
            <div class="article-chip-row">
              {article.data.entities.map((entity) => (
                <a class="article-chip" href={localizedTopicUrlFromName(entity, localePath)}>
                  {entity}
                </a>
              ))}
            </div>
          </section>
        </div>

        <aside class="article-sidebar">
          {tocHeadings.length > 1 && (
            <nav class="toc-card" aria-label={labels.tableOfContents}>
              <p class="mini-label">{labels.tableOfContents}</p>
              <ol>
                {tocHeadings.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <div class="toc-card">
            <p class="mini-label">{labels.whyThisPageExists}</p>
            <p class="toc-copy">{article.data.description}</p>
          </div>

          <div class="toc-card">
            <p class="mini-label">{labels.lastReviewed}</p>
            <p class="toc-copy">
              {dateLabel(article.data.lastReviewed ?? article.data.updatedAt ?? article.data.publishedAt, dateLocale)}
            </p>
          </div>

          <div class="toc-card">
            <p class="mini-label">{labels.directRoute}</p>
            <a class="inline-link" href={canonical}>{articlePath}</a>
            
          </div>
        </aside>
      </section>

      <section class="section article-shell article-sources" aria-labelledby="article-sources-heading">
        <h2 id="article-sources-heading">{labels.sources}</h2>
        <p>{labels.sourcesNote}</p>
        {guideSources.length > 0 && (
          <>
            <h3>{labels.sourcesInGuide}</h3>
            <ul>
              {guideSources.map((source) => (
                <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a></li>
              ))}
            </ul>
          </>
        )}
        <h3>{labels.generalSources}</h3>
        <ul>
          {[...(nationalSourcesByLang[lang] ?? []), ...articleSources].map((source) => (
            <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a></li>
          ))}
        </ul>
      </section>

      <RelatedArticles articles={relatedArticles} title={labels.relatedReading} eyebrow={labels.keepExploring} localePath={localePath} />
    </main>
    <SiteFooter {...footer} localeSwitcher={localeSwitcher} />
  </div>
</BaseLayout>
