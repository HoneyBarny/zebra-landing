---
import '../styles/global.css';
import { siteConfig } from '../data/site-config';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: string;
	publishedTime?: string;
	modifiedTime?: string;
	schema?: Array<Record<string, unknown>>;
}

const {
	title = 'Zebra Symptom Tracker for POTS, EDS & Fibromyalgia',
	description = 'Track flares, orthostatic vitals, symptoms, salt, hydration, and medications in one place. Export a doctor-ready report for specialist appointments.',
	noindex = false,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	schema = [],
} = Astro.props;

// Empty until PUBLIC_META_PIXEL_ID is set. Every pixel branch below is keyed
// off this, so an unconfigured site emits no Meta script, no <noscript> image,
// and no network request — the state the site ships in today.
const metaPixelId = siteConfig.analytics.metaPixelId;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const resolvedOgImage = ogImage
	? Astro.site
		? new URL(ogImage, Astro.site).toString()
		: ogImage
	: undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={siteConfig.assets.favicon.svg} />
		<link rel="icon" href={siteConfig.assets.favicon.ico} />
		<link rel="alternate" type="application/rss+xml" title="Zebra Blog RSS" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#faf7f9" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Zebra" />
		{canonical && <meta property="og:url" content={canonical} />}
		{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		<meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
		{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
		{schema.map((entry) => (
			<script type="application/ld+json" set:html={JSON.stringify(entry)} />
		))}
		<script>
			window.dataLayer = window.dataLayer || [];
			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element
					? event.target.closest('[data-app-store-cta="true"]')
					: null;

				if (!(target instanceof HTMLElement)) {
					return;
				}

				const payload = {
					event: 'zebra_app_store_cta_clicked',
					cta_location: target.dataset.ctaLocation || 'unknown',
					cta_label: target.dataset.ctaLabel || target.textContent?.trim() || 'unknown',
					destination: target instanceof HTMLAnchorElement ? target.href : '',
				};

				window.dataLayer.push(payload);

				if (typeof window.gtag === 'function') {
					window.gtag('event', payload.event, payload);
				}

				// Meta conversion. `fbq` only exists once a Pixel ID is
				// configured *and* consent was granted, so this is a no-op
				// otherwise and the dataLayer/gtag path above is unaffected.
				//
				// Deliberately no `destination` and no URL: Meta gets the two
				// fields needed to tell one placement from another, and nothing
				// that describes where the visitor went or what they read.
				if (typeof window.fbq === 'function') {
					window.fbq('trackCustom', 'appstore_click', {
						cta_location: payload.cta_location,
						cta_label: payload.cta_label,
					});
				}
			});
		</script>

		{metaPixelId && (
			<script is:inline define:vars={{ metaPixelId }}>
				(function () {
					var CONSENT_KEY = 'zebra_consent_v1';

					function consentGranted() {
						try {
							var raw = window.localStorage.getItem(CONSENT_KEY);
							if (!raw) return false;
							return JSON.parse(raw).status === 'granted';
						} catch (error) {
							// No storage access means no recorded opt-in, which
							// is treated as no consent.
							return false;
						}
					}

					function initPixel() {
						// The event can fire more than once across a session,
						// and a stored decision plus an event in the same load
						// would otherwise init twice and double every metric.
						if (window.__zebraPixelReady) return;
						window.__zebraPixelReady = true;

						// Meta's standard bootstrap, injected here rather than
						// in <head> so it cannot run before consent exists.
						!function (f, b, e, v, n, t, s) {
							if (f.fbq) return;
							n = f.fbq = function () {
								n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
							};
							if (!f._fbq) f._fbq = n;
							n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
							t = b.createElement(e); t.async = !0; t.src = v;
							s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
						}(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

						window.fbq('init', metaPixelId);
						window.fbq('track', 'PageView');
						// Top-of-funnel signal for delivery optimisation to
						// learn from, alongside the appstore_click conversion.
						window.fbq('track', 'ViewContent');
					}

					if (consentGranted()) initPixel();

					document.addEventListener('zebra:consent', function (event) {
						if (event.detail && event.detail.status === 'granted') initPixel();
					});
				})();
			</script>
		)}
	</head>
	<body>
		{/*
			First in the body so a keyboard user reaches it on the first Tab and
			a screen reader meets it before the page, without a focus trap.
		*/}
		<ConsentBanner />
		<slot />
		{metaPixelId && (
			<noscript>
				{/*
					A plain <img>, so it fires for a no-JavaScript visitor before
					any consent decision can be recorded — this one CANNOT be
					consent-gated client-side, because the gate is JavaScript.
					It is here because it is Meta's documented snippet, but the
					JS pixel above covers the ads use case on its own. If a
					tracking pixel firing pre-consent for JS-disabled visitors is
					not acceptable for the UK/EU audience, delete this block; you
					lose nothing that matters for optimisation.
				*/}
				<img
					height="1"
					width="1"
					style="display:none"
					alt=""
					src={`https://www.facebook.com/tr?id=${encodeURIComponent(metaPixelId)}&ev=PageView&noscript=1`}
				/>
			</noscript>
		)}
	</body>
</html>
